# Copy to .env.prod on the server and fill in real values. NEVER commit .env.prod.
PORT=8000
GIN_MODE=release

# --- Supabase Postgres ---
# Supabase dashboard → Connect → "Session pooler" (NOT transaction pooler — see note below).
# Host looks like: aws-0-<region>.pooler.supabase.com
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your-db-password>
DB_NAME=postgres
DB_SSL_MODE=require
DB_TIMEZONE=Asia/Kolkata
